node_modules
dist
.playtest

# The fight track is committed so the deployed site has music. It is a cover of
# a Capcom composition, shipped as non-commercial fan use with the takedown risk
# accepted knowingly — see ATTRIBUTION.md. Any other mp3 dropped in here stays
# local.
public/music/*.mp3
!public/music/boss-music.mp3

# scratch bundles from ad-hoc engine probes
.scratch/

# ad-hoc engine probe bundles (agents and manual checks)
.probe/
.verify/
.scratch/

# Bundler output written by a mistyped --outfile. "nul" is a reserved device
# name on Windows, so git cannot even index it and the commit fails outright.
nul.css
nul

# The boss models are COMMITTED — see ATTRIBUTION.md. They are deliberately not
# ignored here, because the deployed site cannot show the barrel without them:
# Wowhead's CDN 403s any cross-origin browser request, so there is no way to
# fetch them at runtime from the host they came from.
